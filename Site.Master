<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Jose_Task_Manager.SiteMaster" %>


<!DOCTYPE html>

<html>


<head runat="server">

<title>
CareTask Hospital System
</title>


<meta name="viewport" content="width=device-width, initial-scale=1">


<link 
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">


<link 
href="~/Content/medical-style.css"
rel="stylesheet">


</head>



<body>


<form id="form1" runat="server">


<nav class="navbar navbar-expand-lg medical-navbar">


<div class="container-fluid">


<a class="navbar-brand medical-logo"
href="<%= ResolveUrl("~/Admin/Dashboard.aspx") %>">

🏥 CareTask

</a>



<button class="navbar-toggler"
type="button"
data-bs-toggle="collapse"
data-bs-target="#menu">

<span class="navbar-toggler-icon"></span>

</button>




<div class="collapse navbar-collapse"
id="menu">



<ul class="navbar-nav ms-auto">


<%
    if (Session["Role"] != null && 
        Session["Role"].ToString() == "Admin")
    {
%>


<li class="nav-item">
<a class="nav-link"
href="<%= ResolveUrl("~/Admin/Dashboard.aspx") %>">
Dashboard
</a>
</li>


<li class="nav-item">
<a class="nav-link"
href="<%= ResolveUrl("~/Admin/ManageTasks.aspx") %>">
Tasks
</a>
</li>


<li class="nav-item">
<a class="nav-link"
href="<%= ResolveUrl("~/Admin/ManageUsers.aspx") %>">
Users
</a>
</li>


<li class="nav-item">
<a class="nav-link"
href="<%= ResolveUrl("~/Admin/ViewHistory.aspx") %>">
History
</a>
</li>


<%
    }
%>



<li class="nav-item">

<a class="nav-link logout-link"
href="<%= ResolveUrl("~/Logout.aspx") %>">

Logout

</a>

</li>


</ul>


</div>


</div>


</nav>




<div class="container mt-5">


<asp:ContentPlaceHolder
ID="MainContent"
runat="server">


</asp:ContentPlaceHolder>



</div>



</form>


</body>


</html>